{
  "name": "avni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Avni — Telegram bot, Mini App, website, and multiplayer games",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "dev:server": "npm run dev -w @avni/server",
    "dev:web": "npm run dev -w @avni/web",
    "build": "npm run build -w @avni/shared && npm run build -w @avni/server && npm run build -w @avni/web"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.48.2",
    "eslint": "^9.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
